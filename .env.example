# Copy this file to .env.local and fill it in. Never commit .env.local.

# Supabase → Project Settings → API (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The only email allowed to sign in
ALLOWED_EMAIL=

# Later stages
# SUPABASE_SERVICE_ROLE_KEY=   # server only, for /api/sync (Stage 10)
# NTFY_TOPIC=                  # Stage 9
# GRADE_SYNC_SECRET=           # Stage 10
