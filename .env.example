# Copy this file to .env.local and fill it in. Never commit .env.local.

# Supabase → Project Settings → API (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The only email allowed to sign in
ALLOWED_EMAIL=

# Server only, never shared: Supabase → Project Settings → API Keys → Secret keys.
# Used by the daily reminder and gradebook sync (no signed-in user there).
SUPABASE_SERVICE_ROLE_KEY=

# Home time zone, used where there's no browser (daily reminder)
NEXT_PUBLIC_TIME_ZONE=America/Phoenix

# The app's public address once deployed (links in phone notifications)
NEXT_PUBLIC_SITE_URL=

# Stage 9: daily "what's due" push. NTFY_TOPIC is a long random name: anyone who knows it can read it.
# Subscribe to it in the ntfy phone app. CRON_SECRET: long random string (Vercel cron sends it).
NTFY_TOPIC=
CRON_SECRET=

# Stage 10: long random string the daily gradebook check sends in the x-sync-secret header
GRADE_SYNC_SECRET=
